# Play Store releases and the store listing. The listing (text, icon, feature
# graphic, screenshots, release notes) lives in fastlane/metadata/android/<locale>/.
#
#   PLAY_JSON_KEY_PATH=path/to/key.json bundle exec fastlane validate
#   PLAY_JSON_KEY_PATH=path/to/key.json bundle exec fastlane metadata
#   PLAY_JSON_KEY_PATH=path/to/key.json bundle exec fastlane deploy track:internal

default_platform(:android)

AAB = "build/app/outputs/bundle/release/app-release.aab"

platform :android do
  desc "Checks the listing and the built bundle against Play without publishing"
  lane :validate do
    upload_to_play_store(
      track: "internal",
      aab: AAB,
      validate_only: true,
    )
  end

  desc "Uploads the store listing text and graphics only"
  lane :metadata do
    upload_to_play_store(
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
    )
  end

  desc "Uploads the release bundle with its listing and release notes"
  lane :deploy do |options|
    upload_to_play_store(
      track: options.fetch(:track, "production"),
      aab: AAB,
      release_status: "completed",
    )
  end
end
