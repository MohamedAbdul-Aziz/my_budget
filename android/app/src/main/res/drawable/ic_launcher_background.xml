<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background. A flat gradient rather than a bitmap, so it
     stays clean at every density and under every launcher mask shape. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="#1E5B48"
        android:startColor="#3E9B7D"
        android:type="linear" />
</shape>
