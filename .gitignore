# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android signing. Never commit the keystore or the passwords that unlock it.
# See https://flutter.dev/to/reference-keystore
*.jks
*.keystore
key.properties

# Supabase CLI cache
supabase/.temp/

# Fastlane / Bundler. The Play service account key is never committed.
/.bundle/
/vendor/bundle/
/fastlane/report.xml
/fastlane/README.md
*play-service-account*.json
